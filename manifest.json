{
  "manifest_version": 3,
  "name": "YouTube Assistant",
  "version": "4.0",
  "description": "AI-powered summaries, topic analysis, chapters, recommendations, chat, and premium extras for YouTube videos",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.youtube.com/*",
    "https://api.lemonsqueezy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "YouTube Assistant"
  }
}
